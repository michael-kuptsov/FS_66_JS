let numbers = [1, 5, 2, 9, 4]

function bubbleSort(arr){
    for (let i = 0; i < arr.length - 1 - i; i++){
        for (let j = 0; j < arr.length- 1 - i; j++){
            if (arr[j] > arr[j + 1]){
                let temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
    return arr
}

function binarySearch(arr, num){
    let left = 0;
    let right = arr.length - 1;

    while (left <= right){
            let middle = Math.floor(left + right) / 2;

            if (arr[middle] === num){
                return middle
            }
            if (num > arr[mid]){
                left = mid + 1;
            }else{
                right = mid - 1;
            }
    }
    return -1;
}